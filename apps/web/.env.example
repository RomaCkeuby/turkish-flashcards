# Copy to apps/web/.env.cloud.local; all VITE_* values are public browser configuration.
VITE_SUPABASE_URL=https://PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_WITH_PUBLIC_KEY
VITE_BASE_PATH=/
# Never set a secret/service-role key, database URL, SMTP credentials or VITE_API_URL here.
